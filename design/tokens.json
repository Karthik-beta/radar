{
  "$description": "Radar design tokens in the Design Tokens Community Group format. Source of truth for colour, type, spacing, radius, motion and breakpoints. See docs/adr/0003-design.md.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#141519", "$description": "Page background (graphite)" },
    "surface": { "$value": "#1c1d22", "$description": "Selected row, active tab, cards" },
    "line": { "$value": "#25272d", "$description": "Dividers" },
    "text": { "$value": "#e8e9ec", "$description": "Primary text" },
    "muted": { "$value": "#8a8d96", "$description": "Secondary text: repo, actor, reason" },
    "faint": { "$value": "#5d6069", "$description": "Tertiary text: sync time, agent mark, key hints" },
    "warm": { "$value": "#e0b062", "$description": "Age past the first waiting threshold" },
    "hot": { "$value": "#f07a5a", "$description": "Age past the second waiting threshold" },
    "red": { "$value": "#ff5a4e", "$description": "Failing CI, and nothing else" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": { "$value": ["Schibsted Grotesk", "system-ui", "sans-serif"], "$description": "All interface text" },
      "display": { "$value": ["Funnel Display", "Schibsted Grotesk", "sans-serif"], "$description": "The Your turn count and its heading only" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700, "$description": "The count only" }
    },
    "size": {
      "$type": "dimension",
      "caption": { "$value": { "value": 12, "unit": "px" }, "$description": "Sync time, key hints, card metadata" },
      "body": { "$value": { "value": 13.5, "unit": "px" }, "$description": "Rows and most text" },
      "title": { "$value": { "value": 17, "unit": "px" }, "$description": "Summary line on Their turn and Pipeline" },
      "heading": { "$value": { "value": 20, "unit": "px" }, "$description": "Count heading on laptop" },
      "heading-phone": { "$value": { "value": 24, "unit": "px" }, "$description": "Count heading at phone width" },
      "count": { "$value": { "value": 72, "unit": "px" }, "$description": "The Your turn count on laptop" },
      "count-phone": { "$value": { "value": 104, "unit": "px" }, "$description": "The Your turn count at phone width" }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" }, "$description": "Page gutter at phone width" },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" }, "$description": "Page gutter on laptop" },
    "7": { "$value": { "value": 28, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" }, "$description": "Key hints" },
    "md": { "$value": { "value": 6, "unit": "px" }, "$description": "Tabs, selected rows, pipeline cards" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "dismiss": { "$value": { "value": 180, "unit": "ms" }, "$description": "A dismissed row sliding out" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "phone": { "$value": { "value": 600, "unit": "px" }, "$description": "At or below this width, rows stack and the count grows" }
  }
}
